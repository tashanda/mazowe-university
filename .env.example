# Copy this to .env.local and set a real PostgreSQL connection string there.
# Example (DO NOT COMMIT real credentials):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

DATABASE_URL="postgresql://user:pass@localhost:5432/mazowe_dev"

# Browser-safe values from Supabase Dashboard > Project Settings > API.
# Never use a service-role or secret key for either variable.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
